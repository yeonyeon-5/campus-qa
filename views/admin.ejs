<%- include('partials/header') %>

<div class="page-header">
  <h1>管理面板</h1>
  <a href="/" class="text-link">← 返回首页</a>
</div>

<% if (message) { %>
  <div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= message %></div>
<% } %>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-art">
      <svg viewBox="0 0 80 50" fill="none" width="80" height="50"><rect x="5" y="5" width="70" height="40" rx="6" stroke="#d6d3d1" stroke-width="1.5" stroke-dasharray="4 3"/><line x1="18" y1="18" x2="62" y2="18" stroke="#e7e5e4" stroke-width="2" stroke-linecap="round"/><line x1="18" y1="26" x2="50" y2="26" stroke="#e7e5e4" stroke-width="2" stroke-linecap="round"/></svg>
    </div>
    <p>还没有任何帖子</p>
  </div>
<% } else { %>
  <div class="admin-wrap">
    <table class="admin-table">
      <thead><tr><th>ID</th><th>标题</th><th>作者</th><th>回复</th><th>状态</th><th>时间</th><th>操作</th></tr></thead>
      <tbody>
        <% posts.forEach(post => { %>
          <tr class="<%= post.is_hidden ? 'row-hidden' : '' %>">
            <td><%= post.id %></td>
            <td><a href="/post/<%= post.id %>"><%= post.title %></a></td>
            <td><%= post.author %></td>
            <td><%= post.reply_count %></td>
            <td><span class="badge <%= post.is_hidden ? 'badge-no' : 'badge-ok' %>"><%= post.is_hidden ? '已隐藏' : '可见' %></span></td>
            <td><%= post.created_at %></td>
            <td>
              <form method="POST" action="/admin/<%= post.id %>/toggle" style="display:inline">
                <button type="submit" class="btn btn-sm <%= post.is_hidden ? 'btn-success' : 'btn-warning' %>">
                  <%= post.is_hidden ? '恢复' : '隐藏' %>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>

<script>
(function(){
  var t=document.getElementById('toast');
  if(t){setTimeout(function(){t.style.opacity='0';t.style.transform='translateX(-50%) translateY(-20px)'},2500)}
})();
</script>
