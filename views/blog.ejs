<%- include('partials/blog-header') %>

<% if (success) { %>
  <div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="toast toast-error" id="toast"><span class="toast-icon">!</span><%= error %></div>
<% } %>

<% if (query) { %>
  <div class="page-header">
    <h1>搜索「<%= query %>」</h1>
    <a href="/blog" class="text-link">← 返回博客</a>
  </div>
<% } else { %>
  <div class="page-header">
    <h1>知识博客</h1>
    <p style="color:var(--t2);font-size:14px;margin-top:4px">经验分享、技术笔记、读书心得——沉淀你的知识</p>
  </div>
<% } %>

<!-- 分类筛选 -->
<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px">
  <% categories.forEach(c => { %>
    <a href="/blog<%= c !== '全部' ? '?cat=' + c : '' %>"
       style="padding:6px 16px;border-radius:20px;font-size:13px;font-weight:600;text-decoration:none;
              <%= (currentCat === c) ? 'background:var(--p);color:#fff' : 'background:var(--card);color:var(--t2);border:1px solid var(--b)' %>">
      <%= c %>
    </a>
  <% }) %>
</div>

<% if (articles.length === 0) { %>
  <div class="empty-state">
    <div class="empty-art" style="font-size:40px">📝</div>
    <h2><%= query ? '没找到相关文章' : '还没有文章' %></h2>
    <p><%= query ? '换个关键词试试' : '成为第一个分享知识的人吧' %></p>
    <% if (!query) { %><a href="/blog/new" class="btn btn-primary">写文章</a><% } %>
  </div>
<% } else { %>
  <div class="post-list">
    <% articles.forEach(a => { %>
      <a href="/blog/<%= a.id %>" class="post-card">
        <span class="post-card-avatar" style="background:var(--avatar<%= (a.author||'').length % 5 %>)"><%= (a.author||'?')[0] %></span>
        <div class="post-card-main">
          <h3 class="post-card-title"><%= a.title %></h3>
          <p class="post-card-preview"><%= (a.summary || a.content || '').length > 100 ? (a.summary || a.content).slice(0, 100) + '...' : (a.summary || a.content || '') %></p>
          <div class="post-card-meta">
            <span class="post-card-author"><%= a.author %></span>
            <span class="post-card-dot">·</span>
            <span><%= a.category || '其他' %></span>
            <span class="post-card-dot">·</span>
            <span>👁 <%= a.views || 0 %></span>
            <span class="post-card-dot">·</span>
            <span><%= a.comment_count || 0 %> 评论</span>
            <span class="post-card-dot">·</span>
            <span><%= a.created_at %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/blog-footer') %>
<script>
(function(){var t=document.getElementById('toast');if(t){setTimeout(function(){t.style.opacity='0';t.style.transform='translateY(-20px)'},2500)}})();
</script>
