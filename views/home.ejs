<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>校园论坛 — 问答 · 博客</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    .hub-page{min-height:100vh;background:linear-gradient(160deg,#fff5f0 0%,#fef9f5 30%,#faf5ff 70%,#f0f4ff 100%);background-attachment:fixed}
    .hub-topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;background:rgba(255,255,255,.72);backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,0,0,.05);position:sticky;top:0;z-index:100}
    .hub-brand{display:flex;align-items:center;gap:9px;font-size:19px;font-weight:800;color:#ea580c;text-decoration:none;letter-spacing:-.01em}
    .hub-brand svg{width:28px;height:28px;color:#ea580c}
    .hub-top-links{display:flex;align-items:center;gap:6px}
    .hub-top-link{font-size:13px;color:#57534e;text-decoration:none;padding:6px 14px;border-radius:20px;transition:all .2s;font-weight:500}
    .hub-top-link:hover{background:#fff7ed;color:#ea580c}
    .hub-top-link.admin{color:#dc2626;font-weight:700}
    .hub-wrap{width:100%;max-width:880px;margin:0 auto;padding:40px 24px 60px}
    .hub-header{text-align:center;margin-bottom:44px}
    .hub-header h1{font-size:38px;font-weight:900;letter-spacing:-.03em;margin-bottom:10px;color:#1c1917;line-height:1.2}
    .hub-header h1 span{background:linear-gradient(135deg,#f97316,#ec4899,#6366f1);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
    .hub-header p{font-size:16px;color:#a8a29e}
    .hub-stats{display:flex;justify-content:center;gap:32px;margin-top:20px}
    .hub-stat{text-align:center}
    .hub-stat strong{display:block;font-size:26px;font-weight:900;color:#1c1917}
    .hub-stat span{font-size:12px;color:#a8a29e}
    /* 主入口双卡片 */
    .hub-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:48px}
    .hub-card{background:#fff;border-radius:24px;padding:36px 32px;text-decoration:none;color:#1c1917;box-shadow:0 4px 32px rgba(0,0,0,.05);transition:all .3s cubic-bezier(.4,0,.2,1);position:relative;overflow:hidden;display:flex;flex-direction:column}
    .hub-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.08)}
    .hub-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px}
    .hub-card-qa::before{background:linear-gradient(90deg,#f97316,#ea580c)}
    .hub-card-blog::before{background:linear-gradient(90deg,#6366f1,#4f46e5)}
    .hub-card-icon{font-size:40px;margin-bottom:16px}
    .hub-card h2{font-size:22px;font-weight:800;margin-bottom:8px}
    .hub-card > p{font-size:14px;color:#a8a29e;line-height:1.6;margin-bottom:20px;flex:1}
    .hub-card-stats{display:flex;gap:20px;font-size:13px;color:#a8a29e;margin-bottom:16px}
    .hub-card-stats strong{font-size:20px;display:block;color:#1c1917}
    .hub-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 22px;border-radius:24px;font-size:14px;font-weight:700;text-decoration:none;transition:all .2s;align-self:flex-start}
    .hub-btn-qa{background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;box-shadow:0 4px 14px rgba(249,115,22,.3)}
    .hub-btn-qa:hover{box-shadow:0 6px 24px rgba(249,115,22,.45)}
    .hub-btn-blog{background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;box-shadow:0 4px 14px rgba(99,102,241,.3)}
    .hub-btn-blog:hover{box-shadow:0 6px 24px rgba(99,102,241,.45)}
    /* 最近动态 */
    .hub-section{margin-bottom:48px}
    .hub-section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .hub-section-header h2{font-size:18px;font-weight:800;color:#1c1917}
    .hub-section-header a{font-size:13px;color:#6366f1;text-decoration:none;font-weight:600}
    .hub-section-header a:hover{opacity:.7}
    .hub-mini-list{display:flex;flex-direction:column;gap:8px}
    .hub-mini-card{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #f1e8e4;border-radius:14px;padding:14px 18px;text-decoration:none;color:#1c1917;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.03)}
    .hub-mini-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.06);transform:translateY(-1px);border-color:#fed7aa}
    .hub-mini-avatar{width:34px;height:34px;min-width:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700}
    .hub-mini-body{flex:1;min-width:0}
    .hub-mini-title{font-size:14px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .hub-mini-meta{font-size:11px;color:#a8a29e;margin-top:2px;display:flex;align-items:center;gap:6px}
    .hub-mini-badge{min-width:20px;height:20px;border-radius:10px;background:#fff7ed;color:#ea580c;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 6px}
    .hub-mini-badge.blog{background:#eef2ff;color:#4f46e5}
    .hub-footer{text-align:center;padding:20px;font-size:12px;color:#a8a29e;border-top:1px solid rgba(0,0,0,.04)}

    @media(max-width:600px){
      .hub-grid{grid-template-columns:1fr;gap:16px}
      .hub-header h1{font-size:28px}
      .hub-card{padding:28px 24px}
      .hub-stats{gap:20px}
      .hub-stat strong{font-size:22px}
      .hub-topbar{padding:12px 16px}
      .hub-wrap{padding:24px 16px 40px}
    }
  </style>
</head>
<body class="hub-page">

  <!-- 顶部导航 -->
  <nav class="hub-topbar">
    <a href="/" class="hub-brand">
      <svg viewBox="0 0 32 32" fill="none"><rect x="2" y="10" width="28" height="18" rx="3" fill="white" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 014-4h0a4 4 0 014 4v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 14h28" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="20" r="2" fill="currentColor"/></svg>
      校园论坛
    </a>
    <div class="hub-top-links">
      <% if (currentUser) { %>
        <a href="/qa" class="hub-top-link">问答</a>
        <a href="/blog" class="hub-top-link">文献</a>
        <a href="/messages" class="hub-top-link">消息</a>
        <a href="/announcements" class="hub-top-link">公告</a>
        <a href="/me" class="hub-top-link">我的</a>
        <% if (currentUser === 'admin') { %><a href="/admin" class="hub-top-link admin">管理</a><% } %>
        <span style="font-size:12px;color:#a8a29e;padding:4px 8px;background:#f5f5f4;border-radius:12px;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= currentUser %></span>
        <a href="/logout" class="hub-top-link" style="color:#ef4444">退出</a>
      <% } else { %>
        <a href="/login" class="hub-top-link">登录</a>
        <a href="/register" class="hub-top-link">注册</a>
      <% } %>
    </div>
  </nav>

  <div class="hub-wrap">
    <!-- Header -->
    <div class="hub-header">
      <h1>有问题，<span>大家一起答</span></h1>
      <p>问答求助 · 知识分享 · 连接每一个需要帮助的人</p>
      <div class="hub-stats">
        <div class="hub-stat"><strong><%= qaCount %></strong><span>个问题</span></div>
        <div class="hub-stat"><strong><%= blogCount %></strong><span>篇文章</span></div>
        <div class="hub-stat"><strong><%= userCount %></strong><span>位同学</span></div>
      </div>
    </div>

    <!-- 双入口卡片 -->
    <div class="hub-grid">
      <a href="/qa" class="hub-card hub-card-qa">
        <div class="hub-card-icon">💬</div>
        <h2>问答社区</h2>
        <p>学习、生活、选课、美食……任何校园里的困惑，都能在这里找到答案。实名社区，互帮互助。</p>
        <div class="hub-card-stats">
          <span><strong><%= qaCount %></strong>个问题</span>
        </div>
        <span class="hub-btn hub-btn-qa">进入问答 →</span>
      </a>

      <a href="/blog" class="hub-card hub-card-blog">
        <div class="hub-card-icon">📚</div>
        <h2>文献博客</h2>
        <p>论文、笔记、教程……把你的学习积累沉淀下来，分享给更多人。好知识值得被传播。</p>
        <div class="hub-card-stats">
          <span><strong><%= blogCount %></strong>篇文章</span>
        </div>
        <span class="hub-btn hub-btn-blog">进入博客 →</span>
      </a>
    </div>

    <!-- 最近帖子 -->
    <% if (recentPosts && recentPosts.length > 0) { %>
    <div class="hub-section">
      <div class="hub-section-header">
        <h2>💬 最新问答</h2>
        <a href="/qa">查看全部 →</a>
      </div>
      <div class="hub-mini-list">
        <% recentPosts.forEach(function(p) { %>
          <a href="/post/<%= p.id %>" class="hub-mini-card">
            <span class="hub-mini-avatar" style="background:var(--avatar<%= p.author.length % 5 %>)"><%= p.author[0] %></span>
            <div class="hub-mini-body">
              <div class="hub-mini-title"><%= p.title %></div>
              <div class="hub-mini-meta">
                <span><%= p.author %></span>
                <span>·</span>
                <span><%= p.reply_count %> 回复</span>
                <span>·</span>
                <span><%= p.created_at %></span>
              </div>
            </div>
            <% if (p.reply_count > 0) { %>
              <span class="hub-mini-badge"><%= p.reply_count %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- 最近文章 -->
    <% if (recentArticles && recentArticles.length > 0) { %>
    <div class="hub-section">
      <div class="hub-section-header">
        <h2>📚 最新文章</h2>
        <a href="/blog">查看全部 →</a>
      </div>
      <div class="hub-mini-list">
        <% recentArticles.forEach(function(a) { %>
          <a href="/blog/<%= a.id %>" class="hub-mini-card">
            <span class="hub-mini-avatar" style="background:var(--avatar<%= a.author.length % 5 %>)"><%= a.author[0] %></span>
            <div class="hub-mini-body">
              <div class="hub-mini-title"><%= a.title %></div>
              <div class="hub-mini-meta">
                <span><%= a.author %></span>
                <span>·</span>
                <span class="tag-badge tag-badge-<%= a.category %>" style="font-size:10px"><%= a.category %></span>
                <span>·</span>
                <span>👁 <%= a.views || 0 %></span>
                <span>·</span>
                <span><%= a.created_at %></span>
              </div>
            </div>
            <% if (a.comment_count > 0) { %>
              <span class="hub-mini-badge blog"><%= a.comment_count %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <div class="hub-footer">
      校园论坛 © 2026 — 连接每一个需要帮助的人
    </div>
  </div>

</body>
</html>
