<%- include('partials/admin-layout', { page: 'dashboard' }) %>

<style>
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:18px}
.stat-box{background:var(--card);border:1px solid var(--b);border-radius:12px;padding:16px 14px;box-shadow:var(--sh);text-align:center}
.stat-box .n{font-size:24px;font-weight:900;line-height:1.1;margin-bottom:2px}
.stat-box .n.c1{color:#f97316}.stat-box .n.c2{color:#6366f1}.stat-box .n.c3{color:#ec4899}.stat-box .n.c4{color:#10b981}.stat-box .n.c5{color:#f59e0b}.stat-box .n.c6{color:#ef4444}
.stat-box .l{font-size:10px;color:var(--t3);text-transform:uppercase;letter-spacing:.05em}
@media(max-width:640px){
  .stats-row{grid-template-columns:repeat(3,1fr);gap:6px}
  .stat-box{padding:10px 8px;border-radius:10px}
  .stat-box .n{font-size:18px}
  .stat-box .l{font-size:9px}
}
</style>

<% var maxH = ranked.length > 0 ? Math.max(1, ranked[0].heat) : 1 %>

<div style="font-size:11px;color:var(--t3);margin-bottom:8px;font-weight:600;letter-spacing:.04em">📝 问答</div>
<div class="stats-row">
  <div class="stat-box"><div class="n c1"><%= stats.total %></div><div class="l">帖子总数</div></div>
  <div class="stat-box"><div class="n c2"><%= stats.visible %></div><div class="l">已发布</div></div>
  <div class="stat-box"><div class="n c6"><%= stats.pending %></div><div class="l">待审核</div></div>
  <div class="stat-box"><div class="n c4"><%= stats.totalReplies %></div><div class="l">回复总数</div></div>
  <div class="stat-box"><div class="n c5"><%= stats.totalLikes %></div><div class="l">点赞总数</div></div>
  <div class="stat-box"><div class="n c3"><%= stats.totalHeat %></div><div class="l">总热度 🔥</div></div>
</div>

<div style="font-size:11px;color:var(--t3);margin-bottom:8px;font-weight:600;letter-spacing:.04em">📄 博客</div>
<div class="stats-row">
  <div class="stat-box"><div class="n c2"><%= stats.blogTotal %></div><div class="l">文章总数</div></div>
  <div class="stat-box"><div class="n c6"><%= stats.blogPending %></div><div class="l">待审核</div></div>
</div>

<div class="page-card">
  <h2>🔥 帖子热度排行榜 <span style="font-size:12px;color:var(--t3);font-weight:400">赞×1 + 回复×2 + 收藏×3</span></h2>
  <div class="table-scroll">
  <table class="data-table">
    <thead><tr><th>#</th><th>标题</th><th>作者</th><th>状态</th><th>👍</th><th>💬</th><th>⭐</th><th>热度</th></tr></thead>
    <tbody>
      <% ranked.forEach((post, i) => { %>
        <% var rk = i + 1; var pct = Math.round(post.heat / maxH * 100); %>
        <tr>
          <td><strong><%= rk === 1 ? '🥇' : rk === 2 ? '🥈' : rk === 3 ? '🥉' : '#' + rk %></strong></td>
          <td><a href="/post/<%= post.id %>" style="color:var(--pd);text-decoration:none;font-weight:600"><%= post.title %></a></td>
          <td><%= post.author %></td>
          <td><span class="badge <%= post.status === 'pending' ? 'badge-new' : post.status === 'rejected' ? 'badge-no' : post.is_hidden ? 'badge-no' : 'badge-ok' %>"><%= post.status === 'pending' ? '审核中' : post.status === 'rejected' ? '已驳回' : post.is_hidden ? '已隐藏' : '可见' %></span></td>
          <td><%= post.like_count %></td>
          <td><%= post.reply_count %></td>
          <td><%= post.bookmark_count %></td>
          <td><span style="display:inline-block;height:6px;border-radius:3px;background:linear-gradient(90deg,#f97316,#ec4899);width:<%= Math.max(8,pct) %>px;vertical-align:middle;margin-right:6px"></span><%= post.heat %></td>
        </tr>
      <% }) %>
      <% if (ranked.length === 0) { %><tr><td colspan="8" style="text-align:center;padding:32px;color:var(--t3)">暂无帖子</td></tr><% } %>
    </tbody>
  </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
