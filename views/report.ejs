<%- include('partials/header') %>

<div class="page-header">
  <h1>🚩 <%= type === 'post' ? '举报帖子' : '举报用户' %></h1>
  <% if (type === 'post') { %><a href="/post/<%= target.id %>" class="text-link">← 返回帖子</a><% } %>
  <% if (type === 'user') { %><a href="/user/<%= encodeURIComponent(target.author) %>" class="text-link">← 返回用户</a><% } %>
</div>

<div class="form-card">
  <% if (error) { %><div style="background:#fef2f2;color:#991b1b;padding:10px 14px;border-radius:10px;margin-bottom:14px;font-size:13px"><%= error %></div><% } %>

  <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:12px;padding:12px 16px;margin-bottom:18px;font-size:13px">
    <strong>举报对象：</strong><%= type === 'post' ? target.title : target.author %><br>
    <strong>类型：</strong><%= type === 'post' ? '帖子' : '用户' %><br>
    <strong>举报人：</strong><%= currentUser %>
  </div>

  <form method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="category">举报类别 <span class="req">*</span></label>
      <select id="category" name="category" class="form-input" required style="cursor:pointer">
        <option value="">-- 请选择举报类别 --</option>
        <option value="违规内容">违规内容（色情、暴力、违法）</option>
        <option value="人身攻击">人身攻击（辱骂、骚扰、网暴）</option>
        <option value="垃圾广告">垃圾广告（推广、刷屏）</option>
        <option value="考试作弊">考试作弊（求代考、泄露试题）</option>
        <option value="虚假信息">虚假信息（造谣、诈骗）</option>
        <option value="隐私泄露">隐私泄露（暴露他人信息）</option>
        <option value="其他">其他（请在下方详细说明）</option>
      </select>
    </div>
    <div class="form-group">
      <label for="reason">详细说明 <span class="req">*</span></label>
      <textarea id="reason" name="reason" class="form-input form-textarea" placeholder="请详细描述具体情况..." rows="4" required></textarea>
    </div>
    <div class="form-group">
      <label>证据截图（可选，最多 5 张）</label>
      <input type="file" name="evidence" accept="image/*" multiple style="font-size:13px;margin-top:4px">
      <p style="font-size:11px;color:var(--t3);margin-top:4px">支持 jpg/png/gif/webp，单张最大 5MB</p>
    </div>
    <button type="submit" class="btn btn-primary">提交举报</button>
  </form>
</div>

<%- include('partials/footer') %>
