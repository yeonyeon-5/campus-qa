<%- include('partials/admin-layout', { page: 'announcements' }) %>

<% if (message) { %><div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= message %></div><% } %>
<% if (error) { %><div class="toast toast-error" id="toast"><span class="toast-icon">!</span><%= error %></div><% } %>

<div class="page-card">
  <h2>📢 发布新公告</h2>
  <form method="POST" action="/admin/announcements/create">
    <div class="form-group">
      <label for="title">公告标题 <span class="req">*</span></label>
      <input type="text" id="title" name="title" class="form-input" placeholder="例如：校园问答平台正式上线" required maxlength="100">
    </div>
    <div class="form-group">
      <label for="content">公告内容 <span class="req">*</span></label>
      <textarea id="content" name="content" class="form-input form-textarea" placeholder="纯文本，支持换行" rows="3" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">📢 发布公告</button>
  </form>
</div>

<div class="page-card">
  <h2>已发布公告 <span style="font-weight:400;font-size:13px;color:var(--t3)"><%= announcements.length %> 条</span></h2>
  <% if (announcements.length === 0) { %>
    <div style="text-align:center;padding:32px;color:var(--t3)">还没有公告</div>
  <% } else { %>
    <div style="display:flex;flex-direction:column;gap:8px">
      <% announcements.forEach(a => { %>
        <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:12px;padding:14px 18px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
          <div>
            <strong>📌 <%= a.title %></strong>
            <div style="font-size:13px;color:var(--t2);margin-top:4px;white-space:pre-wrap;line-height:1.6"><%= a.content %></div>
            <div style="font-size:11px;color:var(--t3);margin-top:4px"><%= a.created_at %></div>
          </div>
          <form method="POST" action="/admin/announcements/<%= a.id %>/delete" onsubmit="return confirm('确定删除？')">
            <button class="btn btn-sm btn-warning">删除</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/admin-footer') %>
