<%- include('partials/header') %>

<% if (success) { %>
  <div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="toast toast-error" id="toast"><span class="toast-icon">!</span><%= error %></div>
<% } %>

<% if (query) { %>
  <div class="page-header">
    <h1>搜索「<%= query %>」</h1>
    <a href="/" class="text-link">← 返回首页</a>
  </div>
<% } else { %>
  <div class="hero">
    <div class="hero-content">
      <h1 class="hero-title">有问题，<span class="hero-highlight">大家一起答</span></h1>
      <p class="hero-sub">学习、生活、选课、美食……任何校园里的困惑，都能在这里找到答案</p>
    </div>
    <a href="/new" class="btn btn-primary btn-lg hero-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      发起提问
    </a>
    <div class="hero-stats"><span><strong><%= posts.length %></strong> 个问题</span></div>
  </div>
<% } %>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-art">
      <svg viewBox="0 0 120 80" fill="none" width="120" height="80"><rect x="30" y="10" width="60" height="45" rx="4" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4 3"/><line x1="40" y1="22" x2="80" y2="22" stroke="#e2e8f0" stroke-width="2" stroke-linecap="round"/><line x1="40" y1="30" x2="65" y2="30" stroke="#e2e8f0" stroke-width="2" stroke-linecap="round"/><line x1="40" y1="38" x2="70" y2="38" stroke="#e2e8f0" stroke-width="2" stroke-linecap="round"/><line x1="40" y1="46" x2="55" y2="46" stroke="#e2e8f0" stroke-width="2" stroke-linecap="round"/><circle cx="100" cy="55" r="14" fill="#f1f5f9" stroke="#cbd5e1" stroke-width="2"/><line x1="92" y1="55" x2="108" y2="55" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round"/><line x1="100" y1="47" x2="100" y2="63" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round"/></svg>
    </div>
    <h2><%= query ? '没有找到相关帖子' : '还没有帖子' %></h2>
    <p><%= query ? '换个关键词试试' : '成为第一个提问的人吧' %></p>
    <% if (!query) { %><a href="/new" class="btn btn-primary">发起提问</a><% } %>
  </div>
<% } else { %>
  <div class="post-list">
    <% posts.forEach((post, i) => { %>
      <a href="/post/<%= post.id %>" class="post-card">
        <span class="post-card-avatar" style="background: var(--avatar<%= getAvatar(post.author) %>)"><%= post.author[0] %></span>
        <div class="post-card-main">
          <h3 class="post-card-title"><%= post.title %></h3>
          <p class="post-card-preview"><%= post.content.length > 100 ? post.content.slice(0, 100) + '...' : post.content %></p>
          <div class="post-card-meta">
            <span class="post-card-author"><%= post.author %></span>
            <span class="post-card-dot">·</span>
            <span><%= post.reply_count %> 回复</span>
            <% if (post.likes && post.likes.length > 0) { %>
              <span class="post-card-dot">·</span>
              <span>👍 <%= post.likes.length %></span>
            <% } %>
            <span class="post-card-dot">·</span>
            <span><%= post.created_at %></span>
          </div>
        </div>
        <% if (post.reply_count > 0) { %>
          <span class="post-card-badge"><%= post.reply_count %></span>
        <% } %>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
<script>
(function(){var t=document.getElementById('toast');if(t){setTimeout(function(){t.style.opacity='0';t.style.transform='translateY(-20px)'},2500)}})();
</script>
