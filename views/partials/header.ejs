<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>校园论坛</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
  <nav class="navbar">
    <div class="container nav-inner">
      <a href="/" class="nav-brand">
        <svg class="nav-logo" viewBox="0 0 32 32" fill="none"><rect x="2" y="10" width="28" height="18" rx="3" fill="white" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 014-4h0a4 4 0 014 4v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 14h28" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="20" r="2" fill="currentColor"/></svg>
        校园论坛
      </a>
      <form class="nav-search" action="/qa" method="GET" autocomplete="off" style="position:relative">
        <input type="text" name="q" id="searchInput" class="nav-search-input" placeholder="搜索帖子..." value="<%= typeof query !== 'undefined' ? query : '' %>" oninput="handleSearchInput(this.value)">
        <div id="suggestDropdown" class="suggest-dropdown" style="display:none"></div>
      </form>
      <div class="nav-links">
        <a href="/" class="nav-link">首页</a>
        <a href="/qa" class="nav-link <%= currentPath === '/qa' ? 'active' : '' %>">问答</a>
        <a href="/announcements" class="nav-link <%= currentPath === '/announcements' ? 'active' : '' %>">公告</a>
        <% if (currentUser !== 'admin') { %>
          <a href="/new" class="nav-link <%= currentPath === '/new' ? 'active' : '' %>">提问</a>
        <% } %>
        <a href="/me" class="nav-link <%= currentPath === '/me' ? 'active' : '' %>">我的</a>
        <% if (currentUser === 'admin') { %><a href="/admin" class="nav-link" style="color:#dc2626;font-weight:700">管理</a><% } %>
        <span class="nav-user"><%= currentUser %></span>
        <a href="/logout" class="nav-link" style="color:#ef4444">退出</a>
      </div>
    </div>
  </nav>
  <main class="container">
