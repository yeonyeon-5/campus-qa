<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>校园论坛</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    .m-nav {
      position: sticky; top: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      height: 56px; padding: 0 40px;
      background: rgba(250,250,248,.8);
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      flex-wrap: nowrap; overflow-x: auto;
    }
    .m-brand {
      display: flex; align-items: center; gap: 10px;
      font-size: 18px; font-weight: 800; color: #1a1a1a;
      text-decoration: none; letter-spacing: -.02em; flex-shrink: 0;
    }
    .m-brand svg { width: 28px; height: 28px; color: #f97316; }
    .m-links { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
    .m-links a {
      font-size: 13px; color: #706f6c; text-decoration: none;
      padding: 6px 15px; border-radius: 8px; font-weight: 500;
      transition: color .2s, background .2s;
    }
    .m-links a:hover { color: #1a1a1a; background: rgba(0,0,0,.04); }
    .m-links a.cur { color: #f97316; font-weight: 600; }
    .m-user {
      font-size: 12px; color: #94928f; margin-left: 12px;
      max-width: 80px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    @media (max-width: 640px) {
      .m-nav { padding: 0 14px; height: 52px; }
      .m-brand { font-size: 15px; gap: 6px; }
      .m-brand svg { width: 22px; height: 22px; }
      .m-links a { font-size: 11px; padding: 5px 10px; }
      .m-user { font-size: 10px; max-width: 60px; }
    }
  </style>
</head>
<body style="background:#fafaf8;min-height:100vh;display:flex;flex-direction:column">

  <nav class="m-nav">
    <a href="/" class="m-brand">
      <svg viewBox="0 0 28 28" fill="none">
        <rect x="1" y="8" width="26" height="17" rx="4" fill="currentColor" opacity=".12"/>
        <path d="M7 8V5a4 4 0 014-4h0a4 4 0 014 4v3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M1 12h26" stroke="currentColor" stroke-width="2.2"/>
        <circle cx="14" cy="18" r="2.2" fill="currentColor"/>
      </svg>
      校园论坛
    </a>
    <div class="m-links">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/" class="<%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'cur' : '' %>">首页</a>
        <a href="/qa">问答</a>
        <a href="/blog">博客</a>
        <a href="/messages" class="<%= typeof currentPath !== 'undefined' && currentPath === '/messages' ? 'cur' : '' %>">消息</a>
        <a href="/announcements">公告</a>
        <a href="/me">我的</a>
        <% if (currentUser === 'admin') { %><a href="/admin" style="color:#dc2626;font-weight:700">管理</a><% } %>
        <span class="m-user"><%= currentUser %></span>
        <a href="/logout" style="color:#ef4444;margin-left:8px">退出</a>
      <% } else { %>
        <a href="/login">登录</a>
        <a href="/register">注册</a>
      <% } %>
    </div>
  </nav>
