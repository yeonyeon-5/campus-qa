<%- include('partials/admin-layout', { page: 'articles' }) %>

<% if (message) { %><div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= message %></div><% } %>

<div class="page-card">
  <h2>📄 文章管理 <span style="background:var(--sl);color:var(--sd);font-size:11px;padding:2px 10px;border-radius:10px"><%= articles.length %></span></h2>
  <% if (articles.length === 0) { %>
    <div style="text-align:center;padding:40px;color:var(--t3)">暂无文章</div>
  <% } else { %>
    <div class="table-scroll">
      <table class="data-table">
        <thead><tr><th>ID</th><th>标题</th><th>作者</th><th>分类</th><th>阅读</th><th>评论</th><th>时间</th><th>状态</th><th>操作</th></tr></thead>
        <tbody>
          <% articles.forEach(a => { %>
            <tr class="<%= a.is_hidden ? 'row-hidden' : '' %>">
              <td><%= a.id %></td>
              <td><a href="/blog/<%= a.id %>" target="_blank" style="color:var(--s);text-decoration:none;font-weight:600;max-width:180px;display:inline-block;overflow:hidden;text-overflow:ellipsis"><%= a.title %></a></td>
              <td><%= a.author %></td>
              <td><span class="badge badge-ok"><%= a.category || '其他' %></span></td>
              <td><%= a.views || 0 %></td>
              <td><%= a.comment_count || 0 %></td>
              <td><%= a.created_at %></td>
              <td><span class="<%= a.is_hidden ? 'badge badge-no' : 'badge badge-ok' %>"><%= a.is_hidden ? '隐藏' : '显示' %></span></td>
              <td style="display:flex;gap:4px">
                <form method="POST" action="/admin/articles/<%= a.id %>/toggle"><button class="btn btn-ghost btn-sm"><%= a.is_hidden ? '显示' : '隐藏' %></button></form>
                <form method="POST" action="/admin/articles/<%= a.id %>/delete" onsubmit="return confirm('确定删除？')"><button class="btn btn-ghost btn-sm" style="color:#ef4444">删除</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/admin-footer') %>
