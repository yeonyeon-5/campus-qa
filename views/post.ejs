<%- include('partials/header') %>

<% if (success) { %>
  <div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="toast toast-error" id="toast"><span class="toast-icon">!</span><%= error %></div>
<% } %>

<div class="page-header">
  <a href="/" class="text-link">← 返回首页</a>
</div>

<article class="post-detail">
  <div class="post-detail-header">
    <a href="/user/<%= encodeURIComponent(post.author) %>" style="text-decoration:none"><span class="post-card-avatar" style="background:var(--avatar<%= getAvatar(post.author) %>)"><%= post.author[0] %></span></a>
    <div><h1 class="post-detail-title"><%= post.title %></h1></div>
  </div>
  <div class="post-detail-meta">
    <span><a href="/user/<%= encodeURIComponent(post.author) %>" style="color:var(--t);text-decoration:none"><strong><%= post.author %></strong></a> 发布于 <%= post.created_at %></span>
  </div>
  <div class="post-detail-content"><%= post.content %></div>

  <div class="post-actions">
    <form method="POST" action="/post/<%= post.id %>/like" style="display:inline">
      <button type="submit" class="action-btn <%= post.liked ? 'action-btn-active' : '' %>">
        👍 <%= (post.likes || []).length %>
      </button>
    </form>
    <form method="POST" action="/post/<%= post.id %>/bookmark" style="display:inline">
      <button type="submit" class="action-btn <%= isBookmarked ? 'action-btn-active' : '' %>">
        ⭐ 收藏 <%= bookmarkCount %>
      </button>
    </form>
  </div>
</article>

<section class="replies-section">
  <h3>回复（<%= replies.length %>）</h3>

  <% if (replies.length === 0) { %>
    <div class="empty-state" style="padding:36px">
      <p style="color:var(--t3);font-size:14px">还没有回复，来抢个沙发吧 🛋️</p>
    </div>
  <% } else { %>
    <div class="reply-list">
      <% replies.forEach(reply => { %>
        <div class="reply-card">
          <div class="reply-top">
            <a href="/user/<%= encodeURIComponent(reply.author) %>" style="text-decoration:none;color:inherit">
              <span class="reply-author">
                <span class="reply-avatar" style="background:var(--avatar<%= getAvatar(reply.author) %>)"><%= reply.author[0] %></span>
                <%= reply.author %>
              </span>
            </a>
            <span class="reply-time"><%= reply.created_at %></span>
          </div>
          <div class="reply-text"><%= reply.content %></div>
          <div style="margin-top:8px">
            <form method="POST" action="/reply/<%= reply.id %>/like" style="display:inline">
              <button type="submit" class="action-btn action-btn-sm <%= reply.liked ? 'action-btn-active' : '' %>">
                👍 <%= (reply.likes || []).length %>
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="reply-form-card">
    <h3 style="font-size:16px;font-weight:700;margin-bottom:14px">写回复</h3>
    <form method="POST" action="/post/<%= post.id %>/reply">
      <div class="form-group">
        <label>回复身份</label>
        <input type="text" class="form-input" value="<%= currentUser %>" disabled style="background:#f5f5f4;color:#a8a29e">
      </div>
      <div class="form-group">
        <label for="content">回复内容 <span class="req">*</span></label>
        <textarea id="content" name="content" class="form-input form-textarea" placeholder="写下你的回答或建议..." rows="3" required></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">提交回复</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
<script>
(function(){var t=document.getElementById('toast');if(t){setTimeout(function(){t.style.opacity='0';t.style.transform='translateX(-50%) translateY(-20px)'},2500)}})();
</script>
