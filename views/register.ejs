<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>注册 · 校园论坛</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    .login-page{min-height:100vh;display:flex;align-items:center;justify-content:center;background:#fafaf8;padding:20px}
    .login-card{background:#fff;border-radius:24px;padding:44px 40px 36px;width:100%;max-width:400px;border:1px solid #eeede8;text-align:center}
    .login-logo{width:56px;height:56px;background:#fff5f0;border-radius:16px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px}
    .login-logo svg{width:32px;height:32px;color:#f97316}
    .login-title{font-size:26px;font-weight:900;letter-spacing:-.02em;margin-bottom:4px;color:#1a1a1a}
    .login-sub{font-size:14px;color:#a8a29e;margin-bottom:28px}
    .login-form{text-align:left}
    .login-form .form-group{margin-bottom:14px}
    .login-form label{display:block;font-size:13px;font-weight:600;margin-bottom:4px;color:#57534e}
    .login-input{width:100%;padding:11px 14px;font-size:14px;border:2px solid #eeede8;border-radius:12px;background:#fafaf9;color:#1a1a1a;font-family:inherit;outline:none;transition:all .2s}
    .login-input:focus{border-color:#f97316;background:#fff;box-shadow:0 0 0 4px rgba(249,115,22,.08)}
    .login-input::placeholder{color:#d6d3d1}
    .login-btn{width:100%;padding:12px;font-size:15px;font-weight:700;border-radius:12px;border:none;cursor:pointer;background:#f97316;color:#fff;font-family:inherit;transition:all .25s;margin-top:4px}
    .login-btn:hover{background:#ea580c}
    .login-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca;padding:10px 14px;border-radius:10px;font-size:13px;margin-bottom:14px;text-align:center}
    .login-footer{font-size:12px;color:#a8a29e;margin-top:16px}
    .login-footer a{color:#f97316;text-decoration:none;font-weight:600}
  </style>
</head>
<body class="login-page">
  <div class="login-card">
    <div class="login-logo">
      <svg viewBox="0 0 32 32" fill="none"><rect x="2" y="10" width="28" height="18" rx="3" fill="white" stroke="currentColor" stroke-width="2"/><path d="M8 10V7a4 4 0 014-4h0a4 4 0 014 4v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M2 14h28" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="20" r="2" fill="currentColor"/></svg>
    </div>
    <h1 class="login-title">注册账号</h1>
    <p class="login-sub">手机号注册，设置你的昵称</p>
    <% if (error) { %><div class="login-error"><%= error %></div><% } %>
    <form method="POST" action="/register" class="login-form">
      <div class="form-group">
        <label for="phone">手机号 <span style="color:#ef4444">*</span></label>
        <input type="tel" id="phone" name="phone" class="login-input" placeholder="请输入11位手机号" maxlength="11" required autofocus value="<%= form.phone || '' %>">
      </div>
      <div class="form-group">
        <label for="nickname">昵称 <span style="color:#ef4444">*</span></label>
        <input type="text" id="nickname" name="nickname" class="login-input" placeholder="设置你的昵称（2-20字符）" maxlength="20" required value="<%= form.nickname || '' %>">
      </div>
      <div class="form-group">
        <label for="password">密码</label>
        <input type="password" id="password" name="password" class="login-input" placeholder="至少 4 位" required>
      </div>
      <div class="form-group">
        <label for="password2">确认密码</label>
        <input type="password" id="password2" name="password2" class="login-input" placeholder="再次输入密码" required>
      </div>
      <button type="submit" class="login-btn">注册</button>
    </form>
    <p class="login-footer">已有账号？<a href="/login">去登录</a></p>
  </div>
</body>
</html>
