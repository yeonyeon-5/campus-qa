<%- include('partials/blog-header') %>

<% if (success) { %>
  <div class="toast toast-success" id="toast"><span class="toast-icon">✓</span><%= success %></div>
<% } %>
<% if (error) { %>
  <div class="toast toast-error" id="toast"><span class="toast-icon">!</span><%= error %></div>
<% } %>

<div class="page-header">
  <h1><%= article.title %></h1>
  <a href="/blog" class="text-link">← 返回博客</a>
</div>

<article style="background:var(--card);border:1px solid var(--b);border-radius:16px;padding:32px;margin-bottom:20px">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap">
    <span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:700;background:var(--pl);color:var(--p)"><%= article.category || '其他' %></span>
    <span style="font-size:13px;color:var(--t3)"><%= article.author %></span>
    <span style="font-size:13px;color:var(--t3)">·</span>
    <span style="font-size:13px;color:var(--t3)">👁 <%= article.views || 0 %> 阅读</span>
    <span style="font-size:13px;color:var(--t3)">·</span>
    <span style="font-size:13px;color:var(--t3)"><%= article.created_at %></span>
  </div>
  <% if (article.tags && article.tags.length > 0) { %>
    <div style="margin-bottom:18px;display:flex;gap:6px;flex-wrap:wrap">
      <% article.tags.forEach(t => { %>
        <span style="padding:2px 8px;border-radius:6px;font-size:11px;background:var(--bg);color:var(--t2)"><%= t %></span>
      <% }) %>
    </div>
  <% } %>
  <div style="font-size:15px;line-height:1.8;color:var(--t);word-break:break-word"><%- (article.content || '').replace(/\n/g, '<br>') %></div>

  <div style="display:flex;align-items:center;gap:12px;margin-top:24px;padding-top:20px;border-top:1px solid var(--b)">
    <form method="POST" action="/blog/<%= article.id %>/like">
      <button style="display:inline-flex;align-items:center;gap:4px;padding:8px 18px;border-radius:10px;border:1px solid var(--b);background:<%= article.liked ? 'var(--pl)' : 'var(--card)' %>;cursor:pointer;font-size:14px;font-family:inherit;color:var(--t)">
        <%= article.liked ? '❤️' : '🤍' %> <%= (article.likes || []).length %>
      </button>
    </form>
  </div>
</article>

<!-- 评论 -->
<div style="background:var(--card);border:1px solid var(--b);border-radius:16px;padding:28px 32px;margin-bottom:20px">
  <h2 style="font-size:18px;font-weight:800;margin:0 0 18px;color:var(--t)">评论（<%= comments.length %>）</h2>

  <% if (comments.length === 0) { %>
    <p style="color:var(--t3);font-size:13px;text-align:center;padding:20px">暂无评论</p>
  <% } else { %>
    <% comments.forEach(c => { %>
      <div style="padding:16px 0;border-bottom:1px solid var(--b)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
          <span style="font-weight:700;font-size:14px;color:var(--t)"><%= c.author %></span>
          <span style="font-size:11px;color:var(--t3)"><%= c.created_at %></span>
        </div>
        <p style="font-size:14px;line-height:1.6;margin:0 0 8px;color:var(--t)"><%= c.content %></p>
        <form method="POST" action="/blog/comment/<%= c.id %>/like" style="display:inline">
          <button style="border:none;background:none;cursor:pointer;font-size:12px;padding:0;font-family:inherit">
            <%= c.liked ? '❤️' : '🤍' %> <%= (c.likes || []).length %>
          </button>
        </form>
      </div>
    <% }) %>
  <% } %>

  <form method="POST" action="/blog/<%= article.id %>/comment" style="margin-top:20px;display:flex;gap:8px">
    <input type="text" name="content" placeholder="写下你的评论..." required
           style="flex:1;padding:10px 16px;border:1px solid var(--b);border-radius:10px;font-size:14px;font-family:inherit;outline:none;background:var(--bg)">
    <button type="submit" class="btn btn-primary">发表</button>
  </form>
</div>

<%- include('partials/blog-footer') %>
<script>
(function(){var t=document.getElementById('toast');if(t){setTimeout(function(){t.style.opacity='0';t.style.transform='translateY(-20px)'},2500)}})();
</script>
